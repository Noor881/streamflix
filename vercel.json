{
    "buildCommand": "node generate-sitemap.js",
    "outputDirectory": ".",
    "framework": null,
    "cleanUrls": false,
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "www.hdwatchzone.com"
                }
            ],
            "destination": "https://hdwatchzone.com/:path*",
            "permanent": true
        },
        {
            "source": "/index.html",
            "destination": "/",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/",
            "destination": "/api/render?route=home"
        },
        {
            "source": "/movie/:id",
            "destination": "/api/render?route=movie&id=:id"
        },
        {
            "source": "/tv/:id/:season/:episode",
            "destination": "/api/render?route=show&id=:id&s=:season&e=:episode"
        },
        {
            "source": "/tv/:id",
            "destination": "/api/render?route=show&id=:id"
        },
        {
            "source": "/movies",
            "destination": "/api/render?route=movies"
        },
        {
            "source": "/tv",
            "destination": "/api/render?route=tv"
        },
        {
            "source": "/anime",
            "destination": "/api/render?route=anime"
        },
        {
            "source": "/new",
            "destination": "/api/render?route=new"
        },
        {
            "source": "/my-list",
            "destination": "/api/render?route=my-list"
        },
        {
            "source": "/genre/:id",
            "destination": "/api/render?route=genre&id=:id"
        },
        {
            "source": "/search",
            "destination": "/api/render?route=search"
        },
        {
            "source": "/faq",
            "destination": "/api/render?route=faq"
        },
        {
            "source": "/privacy",
            "destination": "/api/render?route=privacy"
        },
        {
            "source": "/terms",
            "destination": "/api/render?route=terms"
        },
        {
            "source": "/contact",
            "destination": "/api/render?route=contact"
        },
        {
            "source": "/legal",
            "destination": "/api/render?route=legal"
        },
        {
            "source": "/help",
            "destination": "/api/render?route=help"
        },
        {
            "source": "/cookies",
            "destination": "/api/render?route=cookies"
        },
        {
            "source": "/account",
            "destination": "/api/render?route=account"
        },
        {
            "source": "/admin",
            "destination": "/admin.html"
        },
        {
            "source": "/movie.html",
            "has": [
                {
                    "type": "query",
                    "key": "id",
                    "value": "(?<id>.*)"
                }
            ],
            "destination": "/api/render?route=movie&id=:id"
        },
        {
            "source": "/tv.html",
            "has": [
                {
                    "type": "query",
                    "key": "id",
                    "value": "(?<id>.*)"
                }
            ],
            "destination": "/api/render?route=show&id=:id"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: *; script-src 'self' 'unsafe-inline' 'unsafe-eval' *.googleapis.com *.googletagmanager.com *.ahrefs.com *.analytics.ahrefs.com; img-src * data: blob:; media-src * blob:; frame-src *; connect-src *; font-src * data:"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin-allow-popups"
                },
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "unsafe-none"
                }
            ]
        },
        {
            "source": "/(.*\\.html)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                },
                {
                    "key": "Service-Worker-Allowed",
                    "value": "/"
                }
            ]
        },
        {
            "source": "/(.*\\.(?:js|css|svg|ico))",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                },
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex"
                }
            ]
        },
        {
            "source": "/(.*\\.(?:png|jpg|jpeg|webp|avif|gif))",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, stale-while-revalidate=86400"
                },
                {
                    "key": "Content-Type",
                    "value": "application/xml; charset=utf-8"
                }
            ]
        },
        {
            "source": "/robots.txt",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400"
                }
            ]
        },
        {
            "source": "/llms.txt",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400"
                },
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        },
        {
            "source": "/admin(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                }
            ]
        },
        {
            "source": "/(offline|404)\\.html",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, follow"
                }
            ]
        },
        {
            "source": "/(account|my-list|search)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, follow"
                }
            ]
        },
        {
            "source": "/(docs|seo-results|tests|data)/:path*",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex"
                }
            ]
        },
        {
            "source": "/(.*\\.(?:json|md|cjs))",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex"
                }
            ]
        },
        {
            "source": "/(movie|tv)\\.html",
            "missing": [
                {
                    "type": "query",
                    "key": "id"
                }
            ],
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, follow"
                }
            ]
        }
    ],
    "functions": {
        "api/render.js": {
            "includeFiles": "{index.html,movie.html,tv.html,app.js,detail.js,seo-core.js}",
            "maxDuration": 30
        }
    }
}
